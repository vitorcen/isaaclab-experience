+def _build_camera_feature_map(ckpt_path: str | None, sim_cameras: list[str]) -> dict[str, str] | None:
+    """Resolve {sim_camera_key: model_image_feature_key} from the ckpt's
+    config.json. Returns ``None`` if every sim camera already matches a
+    natural ``observation.images.<sim_key>`` slot in the model — i.e. no
+    rename is needed.
+
+    Falls back to an in-order positional map (sim_cameras zipped with the
+    model's image features) when the model uses non-natural slot names
+    such as `lerobot/smolvla_base`'s `camera1/2/3`.
+    """
+    if not ckpt_path:
+        return None
+    import json
+    import os
+    try:
+        if os.path.isdir(ckpt_path):
+            cfg_path = os.path.join(ckpt_path, "config.json")
+        else:
+            from huggingface_hub import hf_hub_download
+            cfg_path = hf_hub_download(repo_id=ckpt_path, filename="config.json")
+        cfg = json.load(open(cfg_path))
+    except Exception as err:  # noqa: BLE001
+        print(f"[WARN] could not read {ckpt_path}/config.json for feature map: {err}")
+        return None
+
+    expected = [
+        k for k in cfg.get("input_features", {}) if k.startswith("observation.images.")
+    ]
+    if not expected:
+        return None
+    rename = {}
+    for i, sim_key in enumerate(sim_cameras):
+        natural = f"observation.images.{sim_key}"
+        if natural in expected:
+            continue  # natural fit — no rename
+        if i < len(expected):
+            rename[sim_key] = expected[i]  # positional fallback
+    return rename or None
+
+
